{
  "name": "far-cfr-maker",
  "version": "1.0.0",
  "private": true,
  "description": "Build an offline-capable, responsive PWA for Title 14 Federal Aviation Regulations.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node --import=tsx build-far.ts --combined=dist/far/combined.xml --far=dist/far/far.xml --html=dist/far/index.html --parts-dir=dist/far/far-parts",
    "build:aim": "node --import=tsx download-aim.ts --output=dist/aim --clean",
    "check": "tsc --noEmit",
    "test": "node --import=tsx --test",
    "download-aim": "node --import=tsx download-aim.ts --output=dist/aim"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "js-treeview": "^1.1.5",
    "minisearch": "^7.2.0",
    "sharp": "^0.34.5",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
